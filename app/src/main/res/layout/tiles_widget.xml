<?xml version="1.0" encoding="utf-8"?>
<!-- 5x3 grid. The black root background shows through the padding and the
     gaps between tiles, forming the outline and the separators. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grid_line"
    android:orientation="vertical"
    android:padding="@dimen/tile_gap">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/tile_0"
            android:src="@drawable/tile_youtube"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_1"
            android:src="@drawable/tile_samsung_internet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_2"
            android:src="@drawable/tile_notion"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_3"
            android:src="@drawable/tile_k_app"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_4"
            android:src="@drawable/tile_translate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/tile_gap"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/tile_5"
            android:src="@drawable/tile_sheets"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_6"
            android:src="@drawable/tile_gmail"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_7"
            android:src="@drawable/tile_gemini"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_8"
            android:src="@drawable/tile_clock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_9"
            android:src="@drawable/tile_claude"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/tile_gap"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/tile_10"
            android:src="@drawable/tile_calculator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_11"
            android:src="@drawable/tile_android_auto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_12"
            android:src="@drawable/tile_play_store"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_13"
            android:src="@drawable/tile_gallery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
        <ImageView
            android:id="@+id/tile_14"
            android:src="@drawable/tile_nyt_games"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/tile_gap"
            android:background="@color/tile_background"
            android:scaleType="fitCenter"
            android:importantForAccessibility="yes" />
    </LinearLayout>
</LinearLayout>
